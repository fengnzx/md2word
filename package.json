{
  "name": "md2word",
  "version": "1.0.0",
  "description": "A web application to convert Markdown files to Word documents with AI assistance",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd src && npx vite",
    "dev:backend": "cd backend && npx tsx server.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd src && npm run build",
    "build:backend": "tsc -p backend",
    "start": "node backend/dist/server.js",
    "test": "jest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}"
  },
  "keywords": [
    "markdown",
    "word",
    "converter",
    "ai",
    "openai",
    "api"
  ],
  "author": "Markdown to Word Converter Team",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "turndown": "^7.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/turndown": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitejs/plugin-react": "^4.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  }
}